# Copy this to .env and fill in real values before running docker compose

# Kafka
KAFKA_BROKER=kafka://localhost:9092

# PostgreSQL
POSTGRES_DB=flowgraph
POSTGRES_USER=flowgraph
POSTGRES_PASSWORD=changeme

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# pgAdmin
PGADMIN_EMAIL=admin@flowgraph.local
PGADMIN_PASSWORD=changeme
